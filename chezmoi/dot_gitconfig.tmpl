[core]
	ignorecase = false

{{ $profile := includeTemplate "profile" . | fromJson -}}
[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

{{- /* gh is a mise shim: the absolute path serves GUI Git clients without the
shell PATH, and running from $HOME keeps the shim on the global mise config
instead of whatever untrusted mise.toml the current repository carries. */}}
{{- /* git strips unescaped quotes from config values, hence the backslashes. */}}
{{- /* A credential lookup must never turn into a release download; the apply installs gh. */}}
{{- $gh := printf `cd \"$HOME\" && MISE_EXEC_AUTO_INSTALL=0 \"%s/.local/share/mise/shims/gh\"` .chezmoi.homeDir }}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential

[include]
	path = ~/.gitconfig.local
