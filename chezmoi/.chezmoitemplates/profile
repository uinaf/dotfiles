{{- if not (kindIs "map" .profileModel) -}}
{{- fail "profile model must be an object" -}}
{{- end -}}
{{- if ne .profileModel.version 1 -}}
{{- fail "profile model version must be 1" -}}
{{- end -}}
{{- if not (kindIs "map" .profileModel.profiles) -}}
{{- fail "profile model profiles must be an object" -}}
{{- end -}}
{{- range $name, $candidate := .profileModel.profiles -}}
{{- if or (not (kindIs "map" $candidate)) (ne (len (omit $candidate "externalHomebrew")) 4) -}}
{{- fail (printf "profile %s must contain capabilities, brewfiles, skillLayers, and installSteps" $name) -}}
{{- end -}}
{{- if hasKey $candidate "externalHomebrew" -}}
{{- if not (kindIs "slice" $candidate.externalHomebrew) -}}
{{- fail (printf "profile %s externalHomebrew must be an array" $name) -}}
{{- end -}}
{{- range $entry := $candidate.externalHomebrew -}}
{{- if not (kindIs "map" $entry) -}}
{{- fail (printf "profile %s externalHomebrew entry must be an object" $name) -}}
{{- end -}}
{{- if or (ne (len $entry) 2) (not (has $entry.packageType (list "brew" "cask"))) (not (kindIs "string" $entry.name)) (empty $entry.name) -}}
{{- fail (printf "profile %s externalHomebrew entry is invalid" $name) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if or (not (kindIs "map" $candidate.capabilities)) (ne (len $candidate.capabilities) 5) -}}
{{- fail (printf "profile %s capabilities have an invalid shape" $name) -}}
{{- end -}}
{{- range $capability := list "sharedHomebrew" "requiresSopsIdentity" "devbox" "workstation" "personal" -}}
{{- if or (not (hasKey $candidate.capabilities $capability)) (not (kindIs "bool" (index $candidate.capabilities $capability))) -}}
{{- fail (printf "profile %s capability %s must be boolean" $name $capability) -}}
{{- end -}}
{{- end -}}
{{- range $field := list "brewfiles" "skillLayers" "installSteps" -}}
{{- $values := index $candidate $field -}}
{{- if not (kindIs "slice" $values) -}}
{{- fail (printf "profile %s field %s must be an array" $name $field) -}}
{{- end -}}
{{- range $value := $values -}}
{{- if not (kindIs "string" $value) -}}
{{- fail (printf "profile %s field %s must contain strings" $name $field) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if not (has "developer" $candidate.skillLayers) -}}
{{- fail (printf "profile %s skill layers must include developer" $name) -}}
{{- end -}}
{{- if or (not (has "install-runtimes" $candidate.installSteps)) (not (has "install-repository-dependencies" $candidate.installSteps)) -}}
{{- fail (printf "profile %s must install runtimes and repository dependencies" $name) -}}
{{- end -}}
{{- end -}}
{{- if not (hasKey .profileModel.profiles .dotfilesProfile) -}}
{{- fail (printf "unknown dotfiles profile %s" .dotfilesProfile) -}}
{{- end -}}
{{- index .profileModel.profiles .dotfilesProfile | toJson -}}
