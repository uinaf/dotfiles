# Login shell bootstrap. macOS path_helper has already run before this file.

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

typeset -U path PATH

# User binaries must be available to login and non-interactive shells, not only
# interactive .zshrc sessions. Agent harnesses inherit this login-shell PATH.
path+=("$HOME/.local/bin")

# Cursor's installer replaces ~/.local/bin/cursor-agent with a vendor symlink on
# every self-update, so that name is a logged-out vendor CLI until the next
# convergence. This directory holds dotfiles-owned agent launchers only and the
# vendor never writes to it; keep it ahead of ~/.local/bin.
dotfiles_launchers="$HOME/.local/libexec/dotfiles/bin"
if [ -d "$dotfiles_launchers" ]; then
  path=("$dotfiles_launchers" ${path:#$dotfiles_launchers})
fi
unset dotfiles_launchers

# Add mise shims for login/non-interactive shells. Full interactive activation
# runs near the end of .zshrc after PATH edits.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh --shims)"
  # A nested login shell from a mise-active parent inherits the shim directory
  # in PATH, so activate emits no update while brew shellenv has moved ahead of
  # it. Re-front the shims so mise-selected tools keep precedence.
  mise_shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
  path=("$mise_shims" ${path:#$mise_shims})
  unset mise_shims
fi
