{{ $profile := includeTemplate "profile" . | fromJson -}}
[tools]
{{ if eq $profile.runtimeGroup "developer" }}
node = { version = "24.19.0", postinstall = "npm install --global npm@12.0.2 && corepack enable pnpm && corepack install --global pnpm@12.0.0" }
bun = "1.4.0"
python = { version = "3.13", postinstall = "python -m pip install --disable-pip-version-check PyYAML==6.0.3" }
java = "temurin-21"
ruby = "4.0.6"
uv = "0.12.5"
go = "1.26.6"
"npm:@playwright/cli" = "0.1.18"
{{ end }}

[settings]
{{ if $profile.capabilities.developer }}
node.corepack = true
node.npm_shim = false
idiomatic_version_file_enable_tools = ["java"]
trusted_config_paths = ["~/.codex/worktrees", "~/.claude/worktrees"]
{{ end }}
