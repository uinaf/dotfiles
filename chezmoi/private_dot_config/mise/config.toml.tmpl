[tools]
{{ if eq .dotfilesProfile "assistant" }}
node = "24.18.0"
{{ else if ne .dotfilesProfile "service" }}
node = { version = "24.18.0", postinstall = "npm install --global npm@12.0.2 && corepack enable pnpm && corepack install --global pnpm@11.20.0" }
bun = "1.3.10"
python = "3.13"
java = "temurin-21"
uv = "0.11.4"
go = "1.26.2"
"npm:@playwright/cli" = "0.1.17"
{{ end }}

[settings]
{{ if and (ne .dotfilesProfile "assistant") (ne .dotfilesProfile "service") }}
node.corepack = true
node.npm_shim = false
idiomatic_version_file_enable_tools = ["java"]
trusted_config_paths = ["~/.codex/worktrees", "~/.claude/worktrees"]
{{ end }}
