# systemd user services (T3 Code, the maintenance timer) do not read shell
# startup files. This gives the user manager the same PATH front as .zprofile:
# mise shims, the dotfiles agent launchers, and ~/.local/bin.
PATH={{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.local/libexec/dotfiles/bin:{{ .chezmoi.homeDir }}/.local/bin:${PATH}
