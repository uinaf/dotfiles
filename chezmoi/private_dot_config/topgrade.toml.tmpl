{{ $profile := includeTemplate "profile" . | fromJson -}}
[misc]
# Dotfiles convergence applies declared runtime versions; OS upgrades remain manual.
{{ if or $profile.capabilities.sharedHomebrew (ne .chezmoi.os "darwin") -}}
# Shared Homebrew must use the prefix owner's brew-devbox wrapper; Linux has
# no Homebrew and the host owns its packages.
only = ["github_cli_extensions", "custom_commands"]
{{ else -}}
only = ["brew_formula", "brew_cask", "github_cli_extensions", "custom_commands"]
{{ end -}}
assume_yes = true
ask_retry = false
no_self_update = true
notify_end = "on_failure"

[brew]
# Casks that self-update are left to their own updaters. Upgrading them here
# needs the running app quit, which the scheduled job forbids, so greedy_cask
# failed the whole step on whatever happened to be open (google-drive).
# greedy_latest still covers `version :latest` casks, which brew must manage.
greedy_latest = true
autoremove = false

[commands]
"Managed dotfiles" = {{ printf "node %s/scripts/maintenance/converge.ts" (.chezmoi.sourceDir | dir | quote) | toJson }}
"Host hygiene" = {{ printf "node %s/scripts/maintenance/hygiene.ts --apply --scheduled" (.chezmoi.sourceDir | dir | quote) | toJson }}
