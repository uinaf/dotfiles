{{ $profile := includeTemplate "profile" . | fromJson -}}
[misc]
# Runtime pins, repository updates, and operating-system upgrades have separate owners.
{{ if $profile.capabilities.sharedHomebrew -}}
# Shared Homebrew must use the prefix owner's brew-devbox wrapper.
only = ["github_cli_extensions", "custom_commands"]
{{ else -}}
only = ["brew_formula", "brew_cask", "github_cli_extensions", "custom_commands"]
{{ end -}}
assume_yes = true
ask_retry = false
no_self_update = true
notify_end = "on_failure"

[brew]
greedy_cask = true
autoremove = false

[commands]
"Managed agent skills" = {{ printf "mise -C %s run agents:update" (.chezmoi.sourceDir | dir | quote) | toJson }}
