# Devbox Homebrew layer.
# Run through brew-bundle.sh so base and developer layers install first.

# Taps
tap "steipete/tap"
tap "openclaw/tap"

# Cloud CLI
cask "gcloud-cli"

# Agent and devbox CLIs
brew "tmux"
brew "tailscale"
brew "yt-dlp"
brew "openclaw/tap/crabbox"
brew "openclaw/tap/gitcrawl"

# Document, media, and OCR helpers
brew "poppler"
brew "qpdf"
brew "qrencode"
brew "weasyprint"
brew "whisper-cpp"
brew "summarize"

# Devbox tools observed on the shared Mac mini
brew "openclaw/tap/gogcli"
brew "steipete/tap/peekaboo"
brew "uinaf/tap/healthd"
