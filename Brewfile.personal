# Personal additions shared by personal-workstation and personal-devbox.

require "json"

personal_profile = ENV.fetch("HOMEBREW_BUNDLE_DOTFILES_PROFILE")
profile_model = JSON.parse(File.read(File.join(__dir__, "chezmoi/.chezmoidata/profiles.json"))).fetch("profileModel")
raise "unsupported profile model version" unless profile_model.fetch("version") == 1

profile_config = profile_model.fetch("profiles").fetch(personal_profile)
capabilities = profile_config.fetch("capabilities")
unless capabilities.fetch("personal") == true
  raise "Brewfile.personal requires a personal-workstation or personal-devbox profile"
end
workstation_enabled = capabilities.fetch("workstation")
raise "profile workstation capability must be boolean" unless [true, false].include?(workstation_enabled)

# Taps
tap "openclaw/tap", trusted: true
tap "putdotio/tap", trusted: true

# Personal development tools
brew "asc"
brew "uinaf/tap/attach"
brew "openclaw/tap/crabbox"
brew "openclaw/tap/discrawl"
brew "openclaw/tap/gitcrawl"
brew "putdotio/tap/putio-cli"
brew "mole"
brew "pi-coding-agent"

if workstation_enabled
  # App Store automation
  brew "mas"

  # Browsers and sync
  cask "firefox"
  cask "brave-browser"
  cask "google-drive"

  # Networking
  cask "tailscale-app"
  cask "proxyman"

  # Communication
  cask "signal"
  cask "telegram"
  cask "zoom"

  # Agent tools
  cask "grok-build"
  cask "uinaf/tap/slopwake"

  # Cloud tooling
  cask "gcloud-cli"
end

if workstation_enabled
  cask "cleanshot"
  cask "tuna"

  # Platform development
  cask "android-studio"
  cask "raspberry-pi-imager"

  # Media utilities
  cask "imageoptim"
  cask "the-unarchiver"
  cask "vlc"

  # Remote desktop
  cask "parsec"
end
