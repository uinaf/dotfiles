#!/bin/sh
set -eu

repo_root="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
node_version=$(cat "$repo_root/.node-version")

if [ "$#" -eq 1 ]; then
  case "$1" in
    -h|--help)
      printf '%s\n' 'Usage: ./dotfiles prepare | maintain | diff|apply|check PROFILE' \
        'prepare installs repository dependencies; maintain converges the stored profile without retiring logins.'
      exit 0
      ;;
    prepare)
      mise --no-config x "node@$node_version" -- corepack pnpm --dir "$repo_root" install --frozen-lockfile
      exit 0
      ;;
    maintain)
      mise --no-config x "node@$node_version" -- corepack pnpm --dir "$repo_root" install --frozen-lockfile
      exec mise --no-config x "node@$node_version" -- node "$repo_root/scripts/bootstrap/install.ts" --maintenance
      ;;
  esac
fi

if command -v node >/dev/null 2>&1 \
  && (cd "$repo_root" && node -e 'import("effect")' >/dev/null 2>&1); then
  exec node "$repo_root/scripts/dotfiles.ts" "$@"
fi

if ! command -v mise >/dev/null 2>&1; then
  printf 'FAILED: mise is required; install the shared Brewfile first\n' >&2
  exit 1
fi

mise --no-config x "node@$node_version" -- corepack pnpm --dir "$repo_root" install --frozen-lockfile
exec mise --no-config x "node@$node_version" -- corepack pnpm --dir "$repo_root" exec node "$repo_root/scripts/dotfiles.ts" "$@"
