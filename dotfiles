#!/bin/sh
set -eu

repo_root="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
node_version=24.19.0

if command -v node >/dev/null 2>&1 \
  && (cd "$repo_root" && node -e 'import("effect")' >/dev/null 2>&1); then
  exec node "$repo_root/scripts/dotfiles.ts" "$@"
fi

if ! command -v mise >/dev/null 2>&1; then
  printf 'FAILED: mise is required; install the shared Brewfile first\n' >&2
  exit 1
fi

mise x "node@$node_version" -- corepack pnpm --dir "$repo_root" install --frozen-lockfile
exec mise x "node@$node_version" -- corepack pnpm --dir "$repo_root" exec node "$repo_root/scripts/dotfiles.ts" "$@"
