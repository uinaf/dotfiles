#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=scripts/lib/profile.sh
. "$repo_root/scripts/lib/profile.sh"

usage() {
  cat <<'USAGE'
Usage: ./dotfiles diff|apply|check PROFILE

  diff   Preview per-user convergence
  apply  Converge the selected per-user profile
  check  Check the live per-user profile

Homebrew packages, identities, secrets, and host-wide settings remain separate.
USAGE
}

report_boundaries() {
  printf 'Not included: Homebrew packages, identities, secrets, or host-wide settings.\n' >&2
}

delegate() {
  local owner="$1"
  shift
  local status

  if "$@"; then
    return 0
  else
    status=$?
  fi
  printf 'FAILED: %s failed; fix the error above and rerun ./dotfiles %s %s\n' \
    "$owner" "$command_name" "$profile" >&2
  return "$status"
}

if [ "$#" -eq 1 ] && { [ "$1" = -h ] || [ "$1" = --help ]; }; then
  usage
  exit 0
fi
if [ "$#" -ne 2 ]; then
  usage >&2
  exit 2
fi

command_name="$1"
if ! profile="$(dotfiles_normalize_profile "$2")"; then
  printf 'unsupported profile: %s\n' "$2" >&2
  usage >&2
  exit 2
fi

case "$command_name" in
  diff)
    report_boundaries
    printf 'Per-user convergence steps for %s:\n' "$profile"
    delegate scripts/bootstrap/install.sh \
      "$repo_root/scripts/bootstrap/install.sh" --print-steps --profile "$profile"
    printf '\nDotfile changes:\n'
    delegate scripts/bootstrap/apply-dotfiles.sh \
      "$repo_root/scripts/bootstrap/apply-dotfiles.sh" --profile "$profile" --dry-run --verbose
    ;;
  apply)
    report_boundaries
    delegate scripts/bootstrap/install.sh \
      "$repo_root/scripts/bootstrap/install.sh" --profile "$profile"
    ;;
  check)
    report_boundaries
    delegate scripts/verify/bootstrap.sh \
      "$repo_root/scripts/verify/bootstrap.sh" --profile "$profile"
    ;;
  *)
    printf 'unsupported command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
