# Shared development layer for personal-workstation, personal-devbox, workstation, and devbox users.

# Taps
tap "teamookla/speedtest"
tap "uinaf/tap"

# Coding agents
cask "codex"
cask "claude-code@latest"
cask "uinaf/tap/autoreview"
cask "1password-cli"

# Development CLI
brew "git-crypt"
brew "git-filter-repo"
brew "actionlint"
brew "shellcheck"
brew "xcodes"
brew "watchman"

# Download and media helpers
brew "aria2"
brew "ffmpeg"

# Containers
brew "colima"
brew "docker"
brew "docker-buildx"
brew "docker-compose"

# Networking and diagnostics
brew "fping"
brew "teamookla/speedtest/speedtest"

# Security
brew "gitleaks"
brew "lynis"
brew "trufflehog"
