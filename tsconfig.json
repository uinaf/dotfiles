{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "knip.ts",
    "vite.config.ts",
    "agents/**/*.ts",
    "audit/**/*.ts",
    "bootstrap/**/*.ts",
    "homebrew/**/*.ts",
    "identity/**/*.ts",
    "lib/**/*.ts",
    "maintenance/**/*.ts",
    "profiles/**/*.ts",
    "verify/**/*.ts"
  ]
}
